# Safety: placeholders only. Never commit .env.local.
# Never log private keys, view keys, seeds, raw record plaintexts, or full record ciphertexts.

# Runtime
ALEO_ADAPTER_MODE=testnet-credits-local
ALEO_NETWORK=testnet

# Customer testnet-only account
ALEO_CUSTOMER_PRIVATE_KEY=
ALEO_CUSTOMER_VIEW_KEY=
ALEO_CUSTOMER_ADDRESS=

# Merchant testnet-only account
ALEO_MERCHANT_PRIVATE_KEY=
ALEO_MERCHANT_VIEW_KEY=
ALEO_MERCHANT_ADDRESS=

# Optional configuration
ALEO_SCAN_BLOCK_WINDOW=30
ALEO_PAYMENT_AMOUNT_MICROCREDITS=1000000
